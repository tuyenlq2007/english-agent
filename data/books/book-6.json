    },
    {
      "id": "book-6-sentence-018",
      "text": "Lots of love,",
      "meaningVi": "Có thật nhiều tình yêu thương,",
      "type": "sentence"
    },
    {
      "id": "book-6-sentence-019",
      "text": "For you and for me.",
      "meaningVi": "Cho bạn và cho em.",
      "type": "sentence"
    },
    {
      "id": "book-6-sentence-020",
      "text": "Mum and dad,",
      "meaningVi": "Mẹ và bố,",
