    },
    {
      "id": "book-6-sentence-002",
      "text": "Look. This is Mum's book.",
      "meaningVi": "Nhìn này. Đây là quyển sách của mẹ.",
      "type": "sentence"
    },
    {
      "id": "book-6-sentence-003",
      "text": "And this is Billy's teddy.",
      "meaningVi": "Và đây là gấu bông của Billy.",
      "type": "sentence"
    },
    {
